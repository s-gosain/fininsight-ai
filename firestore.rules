rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidSavedAnalysis(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.companyName is string && data.companyName.size() <= 128
        && data.ticker is string && data.ticker.size() <= 32
        && (!('industry' in data) || (data.industry is string && data.industry.size() <= 128))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidUserPreferences(data) {
      return data.userId is string && data.userId.size() <= 128
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 8))
        && (!('preferredTab' in data) || (data.preferredTab is string && data.preferredTab.size() <= 64));
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false; // Profiles are strictly 1-to-1, never listed in bulk
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == userId;
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false; // Profiles are retained

      // User Analyses
      match /analyses/{analysisId} {
        allow get: if isValidId(userId) && isValidId(analysisId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(analysisId) && isOwner(userId) && isValidSavedAnalysis(incoming()) && incoming().userId == userId;
        allow update: if isValidId(userId) && isValidId(analysisId) && isOwner(userId) && isValidSavedAnalysis(incoming()) && incoming().userId == userId && incoming().diff(existing()).affectedKeys().hasOnly(['companyName', 'ticker', 'industry', 'notes', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(analysisId) && isOwner(userId);
      }

      // User Preferences
      match /preferences/{prefId} {
        allow get: if isValidId(userId) && isValidId(prefId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(prefId) && isOwner(userId) && isValidUserPreferences(incoming()) && incoming().userId == userId;
        allow update: if isValidId(userId) && isValidId(prefId) && isOwner(userId) && isValidUserPreferences(incoming()) && incoming().userId == userId && incoming().diff(existing()).affectedKeys().hasOnly(['currency', 'preferredTab', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(prefId) && isOwner(userId);
      }
    }
  }
}
